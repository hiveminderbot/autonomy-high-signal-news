    {
      "id": "hugging-face-papers",
      "name": "Hugging Face Papers",
      "url": "https://huggingface.co/papers",
      "type": "blog_scrape",
      "frequency": "daily",
      "category": "AI Research",
      "domain": "ai",
      "signal_quality": "High",
      "active": true,
      "scrape_config": {
        "list_url": "https://huggingface.co/papers",
        "article_selector": "[data-target='DailyPaper']",
        "title_selector": "h3",
        "link_selector": "a[href^='/papers/']",
        "author_selector": ".author",
        "date_selector": "time",
        "base_url": "https://huggingface.co"
      },
      "notes": "Community-upvoted ML papers with discussions"
    },
