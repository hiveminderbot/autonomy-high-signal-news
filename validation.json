{
  "lab_name": "high-signal-news",
  "version": "1.0.0",
  "description": "Validation configuration for high-signal-news newsletter generation lab",
  "context": {
    "lab_type": "research",
    "critical_paths": [
      "scripts/aggregator/",
      "scripts/briefing/",
      "scripts/extract_with_jina.py"
    ]
  },
  "checks": [
    {
      "check_id": "file_exists",
      "name": "README.md exists",
      "description": "Lab documentation must be present",
      "severity": "required",
      "config": {
        "path": "README.md"
      }
    },
    {
      "check_id": "file_exists",
      "name": "STATUS.json exists",
      "description": "Lab status file must be present",
      "severity": "required",
      "config": {
        "path": "STATUS.json"
      }
    },
    {
      "check_id": "json_valid",
      "name": "STATUS.json is valid JSON",
      "description": "Status file must be valid JSON with required fields",
      "severity": "required",
      "config": {
        "path": "STATUS.json",
        "required_keys": ["name", "status", "version", "components"]
      }
    },
    {
      "check_id": "file_exists",
      "name": "Scripts directory exists",
      "description": "Scripts directory must be present",
      "severity": "required",
      "config": {
        "path": "scripts/"
      }
    },
    {
      "check_id": "file_exists",
      "name": "Aggregator scripts exist",
      "description": "RSS aggregation scripts must be present",
      "severity": "required",
      "strong_correctness": true,
      "config": {
        "path": "scripts/aggregator/"
      }
    },
    {
      "check_id": "file_exists",
      "name": "Briefing scripts exist",
      "description": "Briefing generation scripts must be present",
      "severity": "required",
      "strong_correctness": true,
      "config": {
        "path": "scripts/briefing/"
      }
    },
    {
      "check_id": "file_exists",
      "name": "Content extraction script exists",
      "description": "Content extraction script must be present",
      "severity": "required",
      "strong_correctness": true,
      "config": {
        "path": "scripts/extract_with_jina.py"
      }
    },
    {
      "check_id": "python_syntax",
      "name": "Content extraction syntax valid",
      "description": "Content extraction script must have valid Python syntax",
      "severity": "required",
      "strong_correctness": true,
      "config": {
        "path": "scripts/extract_with_jina.py"
      }
    },
    {
      "check_id": "file_exists",
      "name": "Database exists",
      "description": "News database must be present",
      "severity": "warn",
      "config": {
        "path": "news.db"
      }
    },
    {
      "check_id": "file_exists",
      "name": "Sources catalog exists",
      "description": "Sources directory must exist",
      "severity": "required",
      "config": {
        "path": "sources/"
      }
    },
    {
      "check_id": "file_exists",
      "name": "Requirements file exists",
      "description": "Python dependencies should be documented",
      "severity": "warn",
      "config": {
        "path": "requirements.txt"
      }
    },
    {
      "check_id": "file_exists",
      "name": "Git repository initialized",
      "description": "Lab should be a git repository",
      "severity": "warn",
      "config": {
        "path": ".git/"
      }
    }
  ]
}
