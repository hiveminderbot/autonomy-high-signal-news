[Unit]
Description=High-Signal News Daily Aggregation
Documentation=https://forgejo.internal/autonomy/high-signal-news
After=network.target

[Service]
Type=oneshot
User=exedev
Group=exedev
WorkingDirectory=/home/exedev/autonomy/labs/high-signal-news
Environment="PATH=/home/exedev/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin:/usr/bin:/bin"
Environment="BEADS_DIR=/home/exedev/autonomy/.beads"

# Run the daily aggregation through the Nix-backed wrapper
ExecStart=/home/exedev/autonomy/labs/high-signal-news/scripts/aggregator/systemd/run-daily-aggregation-nix.sh \
    --db state/aggregation.db \
    --newsletter-db state/newsletters.db \
    --catalog sources/sources-ai.json \
    --newsletter-catalog sources/newsletter_catalog.json \
    --output-dir output \
    --log-dir logs

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/exedev/autonomy/labs/high-signal-news/state \
               /home/exedev/autonomy/labs/high-signal-news/output \
               /home/exedev/autonomy/labs/high-signal-news/logs

[Install]
WantedBy=multi-user.target
